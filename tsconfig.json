{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "types": [],
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "whale-ui": [
        "./packages"
      ],
      "@whale-ui/*": [
        "./packages/*"
      ]  
    }
  },
  "include": [
    "packages/**/*.vue",
    "packages/**/*.ts",
    "build/**/*.ts",
    "docs/**/*.vue",
    "docs/**/*.ts",
    "docs/**/*.mts",
  ],
  "exclude": [
    "node_modules",
    "dist",
    "play"
  ]
}
